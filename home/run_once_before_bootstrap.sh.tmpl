{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Bootstrap the two things everything else in this repo depends on: Homebrew,
# and fish.
#
# fish is installed here rather than left to the Brewfile because the later
# scripts (set-fish-shell, fisher) can't run without it, and `brew bundle`
# installs ~50 packages — if any one of them fails, or the run is interrupted,
# those scripts would find no fish. This runs in the "before" phase, so fish
# exists before anything else is applied.
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "🍺 Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Put brew on PATH for the rest of this script — on a fresh Apple Silicon Mac
# it has just been installed into /opt/homebrew and isn't on PATH yet.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "❌ Homebrew install did not succeed — cannot continue." >&2
  exit 1
fi
echo "✅ Homebrew at $(command -v brew)"

if ! command -v fish >/dev/null 2>&1; then
  echo "🐟 Installing fish..."
  brew install fish
fi
echo "✅ fish at $(command -v fish)"
{{ end -}}
